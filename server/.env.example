# RuralSync Server Environment Configuration Template
# Duplicate this file to .env and provide your actual credentials.
# NEVER commit the real .env file into version control.

# Server Port & Runtime Environment
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/RuralSync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for Client
CLIENT_URL=http://localhost:3000

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here

# ImageKit Cloud Storage Configuration (for grievances & document uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Email Service (Nodemailer SMTP - optional for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=RuralSync
